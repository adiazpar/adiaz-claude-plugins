{
  "$schema": "plugin://re-discipline/schemas/knowledge-settings.schema.json",
  "schemaVersion": 2,
  "sources": {
    "truth": true,
    "historyFindings": true,
    "backlog": true,
    "activeFindings": true,
    "sharedMemory": true,
    "reportFallback": true,
    "additional": []
  },
  "models": {
    "execution": "local"
  },
  "telemetry": {
    "mode": "metrics-only"
  },
  "budgets": {
    "searchTokens": 1024,
    "managerContextTokens": 2048,
    "drafterContextTokens": 1024,
    "maxCards": 12,
    "maxBytes": 32768
  },
  "archive": {
    "reportFallbackUntilMeasured": true,
    "normalizationTriggerHits": 3,
    "fallbackMode": "default-fallback"
  }
}
