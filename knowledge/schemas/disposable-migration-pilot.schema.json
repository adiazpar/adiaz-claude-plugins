{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plugin://re-discipline/schemas/disposable-migration-pilot.schema.json",
  "title": "Disposable Migration Pilot Receipt",
  "type": "object",
  "required": [
    "$schema", "schemaVersion", "kind", "receiptSequence", "priorReceiptDigest",
    "updatedAt", "pilot", "liveCampaign", "phase", "createdAt", "repositories",
    "disposableCopies", "completeProjectTreeRetained", "liveCampaignIsCertificationScopeOnly",
    "productionBoundary", "package", "tools", "preview", "decisionRequest",
    "failureInjections", "commands", "receiptDigest"
  ],
  "properties": {
    "$schema": {"const": "plugin://re-discipline/schemas/disposable-migration-pilot.schema.json"},
    "schemaVersion": {"const": 1},
    "kind": {"const": "re-discipline-disposable-migration-pilot-v1"},
    "receiptSequence": {"type": "integer", "minimum": 1},
    "priorReceiptDigest": {
      "anyOf": [{"const": ""}, {"$ref": "#/$defs/digest"}]
    },
    "updatedAt": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "pilot": {"enum": ["small", "scale"]},
    "liveCampaign": {"enum": ["prelude-pack-recalibration", "resource-registration"]},
    "phase": {
      "enum": [
        "manager-decisions-required", "coverage-review-required",
        "certification-evidence-required", "completed"
      ]
    },
    "createdAt": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "repositories": {
      "type": "object",
      "required": ["plugin", "project"],
      "properties": {
        "plugin": {"$ref": "#/$defs/repository"},
        "project": {"$ref": "#/$defs/repository"}
      },
      "additionalProperties": false
    },
    "disposableCopies": {
      "type": "object",
      "required": ["plugin", "project"],
      "properties": {
        "plugin": {"$ref": "#/$defs/copy"},
        "project": {"$ref": "#/$defs/copy"}
      },
      "additionalProperties": false
    },
    "completeProjectTreeRetained": {"const": true},
    "liveCampaignIsCertificationScopeOnly": {"const": true},
    "productionBoundary": {"type": "object"},
    "package": {"type": "object"},
    "tools": {"type": "object"},
    "preview": {"type": "object"},
    "decisionRequest": {"$ref": "#/$defs/artifact"},
    "failureInjections": {"type": "array", "minItems": 2, "items": {"type": "object"}},
    "commands": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "managerSubmissions": {"type": "array", "items": {"type": "object"}},
    "reviewedPreview": {"type": "object"},
    "migrationState": {"type": "object"},
    "coverageRequest": {"$ref": "#/$defs/artifact"},
    "coverageSubmissions": {"type": "array", "items": {"type": "object"}},
    "intrinsicGates": {"type": "array", "items": {"type": "object"}},
    "certificationEvidenceRequest": {"$ref": "#/$defs/artifact"},
    "ordinaryProjectFileProof": {"type": "object"},
    "externalEvidenceInstallation": {"type": "object"},
    "externalGates": {"type": "array", "items": {"type": "object"}},
    "candidateCertification": {"$ref": "#/$defs/artifact"},
    "certificationApproval": {"$ref": "#/$defs/artifact"},
    "finalResult": {"$ref": "#/$defs/artifact"},
    "receiptDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "artifact": {
      "type": "object",
      "required": ["path", "sha256", "byteCount"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "^[^\\\\]+$"},
        "sha256": {"$ref": "#/$defs/digest"},
        "byteCount": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "repository": {
      "type": "object",
      "required": ["revision", "tree", "trackedFileCount", "trackedManifestSha256", "clean"],
      "properties": {
        "revision": {"$ref": "#/$defs/revision"},
        "tree": {"$ref": "#/$defs/revision"},
        "trackedFileCount": {"type": "integer", "minimum": 1},
        "trackedManifestSha256": {"$ref": "#/$defs/digest"},
        "clean": {"const": true}
      },
      "additionalProperties": false
    },
    "copy": {
      "type": "object",
      "required": [
        "revision", "tree", "trackedFileCount", "trackedManifestSha256",
        "sourceWorkingBytesExact"
      ],
      "properties": {
        "revision": {"$ref": "#/$defs/revision"},
        "tree": {"$ref": "#/$defs/revision"},
        "trackedFileCount": {"type": "integer", "minimum": 1},
        "trackedManifestSha256": {"$ref": "#/$defs/digest"},
        "sourceWorkingBytesExact": {"const": true}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
