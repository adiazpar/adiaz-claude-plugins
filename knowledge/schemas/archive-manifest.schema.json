{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plugin://re-discipline/schemas/archive-manifest.schema.json",
  "title": "Campaign Archive Manifest",
  "type": "object",
  "required": ["schemaVersion", "campaignId", "closedAt", "sourceDigest", "files", "projections", "coverage", "eventHead", "digest"],
  "properties": {
    "schemaVersion": {"const": 2},
    "campaignId": {"type": "string", "pattern": "^C-[A-Z0-9][A-Z0-9-]{0,62}$"},
    "closedAt": {"type": "string", "format": "date-time"},
    "sourceDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "files": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
    "projections": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
    "coverage": {"$ref": "closure-coverage.schema.json"},
    "eventHead": {"type": "string", "pattern": "^E-[0-9]{8}-[0-9]{6}-[A-Z0-9]{6,}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
