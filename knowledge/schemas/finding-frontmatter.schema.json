{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plugin://re-discipline/schemas/finding-frontmatter.schema.json",
  "title": "Re-Discipline Canonical Finding Frontmatter",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "campaignId",
    "revision",
    "createdAt",
    "updatedAt",
    "createdBy",
    "updatedBy",
    "digest",
    "correlationId",
    "kind",
    "subject",
    "claim",
    "scope",
    "appliesWhen",
    "knownLimits",
    "tags",
    "subsystems",
    "aliases",
    "sourceRuns",
    "evidence",
    "supports",
    "contradicts",
    "dependsOn",
    "supersedes",
    "duplicates",
    "answers",
    "spawned",
    "evidenceGrade",
    "reviewState",
    "validity",
    "projection",
    "syntheticQuestions",
    "questionsReviewed"
  ],
  "properties": {
    "schemaVersion": {"const": 2},
    "id": {"type": "string", "pattern": "^F-[0-9]{4,}$"},
    "campaignId": {"type": "string", "pattern": "^C-[A-Z0-9][A-Z0-9-]{0,62}$"},
    "revision": {"type": "integer", "minimum": 1},
    "createdAt": {"$ref": "#/$defs/utcTimestamp"},
    "updatedAt": {"$ref": "#/$defs/utcTimestamp"},
    "createdBy": {"$ref": "#/$defs/nonEmptyLine"},
    "updatedBy": {"$ref": "#/$defs/nonEmptyLine"},
    "digest": {"$ref": "#/$defs/sha256"},
    "correlationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "kind": {
      "enum": [
        "observation",
        "conclusion",
        "method",
        "decision",
        "constraint",
        "dead-end",
        "open-question"
      ]
    },
    "subject": {"$ref": "#/$defs/nonEmptyLine"},
    "claim": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?=.*\\S)[^\\r\\n]+$"
    },
    "scope": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9]*$"},
      "additionalProperties": {
        "anyOf": [
          {"type": "string"},
          {"type": "number"},
          {"type": "boolean"},
          {
            "type": "array",
            "items": {"type": "string"}
          }
        ]
      }
    },
    "appliesWhen": {"$ref": "#/$defs/nonEmptyLines"},
    "knownLimits": {"$ref": "#/$defs/nonEmptyLines"},
    "tags": {"$ref": "#/$defs/uniqueNonEmptyLines"},
    "subsystems": {"$ref": "#/$defs/uniqueNonEmptyLines"},
    "aliases": {"$ref": "#/$defs/uniqueNonEmptyLines"},
    "sourceRuns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/runId"}
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "finding-evidence.schema.json"}
    },
    "supports": {"$ref": "#/$defs/findingIds"},
    "contradicts": {"$ref": "#/$defs/findingIds"},
    "dependsOn": {"$ref": "#/$defs/findingIds"},
    "supersedes": {"$ref": "#/$defs/findingIds"},
    "duplicates": {"$ref": "#/$defs/findingIds"},
    "answers": {"$ref": "#/$defs/findingIds"},
    "spawned": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^W-[0-9]{4,}$"}
    },
    "evidenceGrade": {"enum": ["direct", "inferred", "reported", "unknown"]},
    "reviewState": {"enum": ["extracted", "curator-checked", "manager-ratified", "manager-rejected"]},
    "validity": {"enum": ["provisional", "current", "challenged", "historical", "superseded", "invalid"]},
    "projection": {"enum": ["none", "campaign", "truth", "history", "backlog", "playbook", "maintained", "archive", "rejected"]},
    "policyId": {"$ref": "#/$defs/nonEmptyLine"},
    "verifiedAt": {
      "oneOf": [
        {"type": "string", "format": "date"},
        {"$ref": "#/$defs/utcTimestamp"}
      ]
    },
    "syntheticQuestions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\r\\n]*\\?[^\\S\\r\\n]*$"
      }
    },
    "questionsReviewed": {"const": true}
  },
  "allOf": [
    {
      "if": {
        "properties": {"validity": {"const": "current"}},
        "required": ["validity"]
      },
      "then": {
        "properties": {
          "evidenceGrade": {"const": "direct"},
          "reviewState": {"const": "manager-ratified"}
        }
      }
    },
    {
      "if": {
        "properties": {"validity": {"const": "superseded"}},
        "required": ["validity"]
      },
      "then": {
        "properties": {"supersedes": {"maxItems": 0}}
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "runId": {
      "type": "string",
      "pattern": "^R-[0-9]{8}-[0-9]{4,}$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "nonEmptyLine": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=.*\\S)[^\\r\\n]+$"
    },
    "nonEmptyLines": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonEmptyLine"}
    },
    "uniqueNonEmptyLines": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonEmptyLine"}
    },
    "findingIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^F-[0-9]{4,}$"}
    }
  },
  "additionalProperties": false
}
