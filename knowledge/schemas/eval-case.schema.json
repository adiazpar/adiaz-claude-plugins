{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plugin://re-discipline/schemas/eval-case.schema.json",
  "title": "Re-Discipline retrieval evaluation case",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "role", "topic", "split", "query", "queryClass", "allowedTiers", "corpusSnapshot", "expectedPaths", "minimumEvidencePaths", "hardNegativePaths", "expectedCitations", "forbiddenTiers", "tokenBudget", "answerable"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "role": {"enum": ["manager", "drafter"]},
    "topic": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "split": {"enum": ["development", "holdout"]},
    "query": {"type": "string", "minLength": 1, "maxLength": 1000},
    "queryClass": {"enum": ["auto", "exact", "conceptual", "orientation", "current", "provenance", "dependency", "contradiction"]},
    "vocabularyPolicy": {"enum": ["target-disjoint-v1"]},
    "allowedTiers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["profile", "navigation", "truth", "history", "backlog", "active", "memory", "asset", "campaign", "draft", "provisional", "archive", "intake", "playbook"]}
    },
    "corpusSnapshot": {"type": "string", "pattern": "^(fixture:[a-z0-9-]+|sha256:[a-f0-9]{64})$"},
    "expectedPaths": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "pattern": "^(?:[^./\\\\:\\x00][^/\\\\:\\x00]*|\\.[^./\\\\:\\x00][^/\\\\:\\x00]*|\\.\\.[^/\\\\:\\x00]+)(?:/(?:[^./\\\\:\\x00][^/\\\\:\\x00]*|\\.[^./\\\\:\\x00][^/\\\\:\\x00]*|\\.\\.[^/\\\\:\\x00]+))*$"}
    },
    "gradedRelevantPaths": {
      "type": "object",
      "propertyNames": {"minLength": 1, "pattern": "^(?:[^./\\\\:\\x00][^/\\\\:\\x00]*|\\.[^./\\\\:\\x00][^/\\\\:\\x00]*|\\.\\.[^/\\\\:\\x00]+)(?:/(?:[^./\\\\:\\x00][^/\\\\:\\x00]*|\\.[^./\\\\:\\x00][^/\\\\:\\x00]*|\\.\\.[^/\\\\:\\x00]+))*$"},
      "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 3}
    },
    "minimumEvidencePaths": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "pattern": "^(?:[^./\\\\:\\x00][^/\\\\:\\x00]*|\\.[^./\\\\:\\x00][^/\\\\:\\x00]*|\\.\\.[^/\\\\:\\x00]+)(?:/(?:[^./\\\\:\\x00][^/\\\\:\\x00]*|\\.[^./\\\\:\\x00][^/\\\\:\\x00]*|\\.\\.[^/\\\\:\\x00]+))*$"}
    },
    "hardNegativePaths": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "pattern": "^(?:[^./\\\\:\\x00][^/\\\\:\\x00]*|\\.[^./\\\\:\\x00][^/\\\\:\\x00]*|\\.\\.[^/\\\\:\\x00]+)(?:/(?:[^./\\\\:\\x00][^/\\\\:\\x00]*|\\.[^./\\\\:\\x00][^/\\\\:\\x00]*|\\.\\.[^/\\\\:\\x00]+))*$"}
    },
    "expectedCitations": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "pattern": "^(?:[^./\\\\:\\x00][^/\\\\:\\x00]*|\\.[^./\\\\:\\x00][^/\\\\:\\x00]*|\\.\\.[^/\\\\:\\x00]+)(?:/(?:[^./\\\\:\\x00][^/\\\\:\\x00]*|\\.[^./\\\\:\\x00][^/\\\\:\\x00]*|\\.\\.[^/\\\\:\\x00]+))*$"}
    },
    "forbiddenTiers": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["profile", "navigation", "truth", "history", "backlog", "active", "memory", "asset", "campaign", "draft", "provisional", "archive", "intake", "playbook"]}
    },
    "tokenBudget": {"type": "integer", "minimum": 128, "maximum": 4096},
    "answerable": {"type": "boolean"},
    "evidencePins": {
      "description": "Per-document pins. When present these replace corpusSnapshot for gating: claimSha256 changes only when a pinned document changes what it asserts, so editing evidence prose elsewhere in the corpus does not invalidate the case.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "claimSha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "claimSha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
          "contentSha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"answerable": {"const": true}}},
      "then": {"properties": {"expectedPaths": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"answerable": {"const": false}}},
      "then": {
        "properties": {
          "expectedPaths": {"maxItems": 0},
          "minimumEvidencePaths": {"maxItems": 0},
          "expectedCitations": {"maxItems": 0}
        }
      }
    }
  ]
}
