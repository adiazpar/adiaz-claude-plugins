{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plugin://re-discipline/schemas/benchmark-result.schema.json",
  "title": "Packaged knowledge benchmark report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mode", "suite", "hardNegativeCoverage", "profiles", "passed"],
  "properties": {
    "schemaVersion": {"const": 1},
    "mode": {"enum": ["quick", "full"]},
    "suite": {"const": "packaged-conformance-v1"},
    "hardNegativeCoverage": {"$ref": "#/$defs/hardNegativeCoverage"},
    "profiles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/profile"}},
    "passed": {"type": "boolean"}
  },
  "$defs": {
    "hardNegativeCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["answerableCases", "coveredCases", "coverage"],
      "properties": {
        "answerableCases": {"type": "integer", "minimum": 0},
        "coveredCases": {"type": "integer", "minimum": 0},
        "coverage": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "profile": {
      "type": "object",
      "required": ["profileName", "declaredDigest", "computedDigest", "digestVerified", "passed", "nonInferiorToLexical", "cases", "casesByBudget", "contextPackCases", "contextPacksByBudget", "contextPackRoles", "contextPackPassed", "metrics", "holdoutMetrics", "metricsBySplit", "metricsByBudget", "qualityMetricsByBudget", "findingEvaluation"],
      "properties": {
        "profileName": {"type": "string", "minLength": 1},
        "declaredDigest": {"type": "string"},
        "computedDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "digestVerified": {"type": "boolean"},
        "passed": {"type": "boolean"},
        "nonInferiorToLexical": {"type": "boolean"},
        "cases": {"type": "array"},
        "casesByBudget": {"type": "object"},
        "contextPackCases": {"type": "array"},
        "contextPacksByBudget": {"type": "object"},
        "contextPackRoles": {"type": "array", "items": {"enum": ["manager", "drafter"]}},
        "contextPackPassed": {"type": "boolean"},
        "metrics": {"type": "object"},
        "holdoutMetrics": {"type": "object"},
        "metricsBySplit": {"type": "object"},
        "metricsByBudget": {"type": "object"},
        "qualityMetricsByBudget": {"type": "object"},
        "findingEvaluation": {"type": "object"},
        "computedEvidence": {"type": "object"}
      },
      "additionalProperties": false
    }
  }
}
