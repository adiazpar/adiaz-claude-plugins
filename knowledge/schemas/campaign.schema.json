{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plugin://re-discipline/schemas/campaign.schema.json",
  "title": "Re-Discipline Campaign Record",
  "type": "object",
  "required": ["schemaVersion", "id", "createdAt", "updatedAt", "revision", "createdBy", "updatedBy", "digest", "correlationId", "title", "slug", "objective", "scope", "exclusions", "successCriteria", "closureCriteria", "status", "currentFocus", "owner", "permittedManagers", "openedAt", "lastEventId"],
  "properties": {
    "schemaVersion": {"const": 2},
    "id": {"type": "string", "pattern": "^C-[A-Z0-9][A-Z0-9-]{0,62}$"},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"},
    "revision": {"type": "integer", "minimum": 1},
    "createdBy": {"type": "string", "minLength": 1},
    "updatedBy": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "correlationId": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,49}$"},
    "objective": {"type": "string", "minLength": 1},
    "scope": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "exclusions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "successCriteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "closureCriteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "status": {"enum": ["open", "paused", "closing", "closed", "cancelled"]},
    "currentFocus": {"type": "array", "items": {"type": "string", "pattern": "^W-[0-9]{4,}$"}, "uniqueItems": true},
    "milestones": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "owner": {"type": "string", "minLength": 1},
    "permittedManagers": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "openedAt": {"type": "string", "format": "date-time"},
    "pausedAt": {"type": "string", "format": "date-time"},
    "closingAt": {"type": "string", "format": "date-time"},
    "closedAt": {"type": "string", "format": "date-time"},
    "lastEventId": {"type": "string", "pattern": "^E-[0-9]{8}-[0-9]{6}-[A-Z0-9]{6,}$"},
    "archiveDestination": {"type": "string", "pattern": "^docs/history/campaigns/[a-z0-9][a-z0-9-]{2,49}$"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "paused"}}}, "then": {"required": ["pausedAt"]}},
    {"if": {"properties": {"status": {"const": "closing"}}}, "then": {"required": ["closingAt"]}},
    {"if": {"properties": {"status": {"const": "closed"}}}, "then": {"required": ["closedAt", "archiveDestination"]}}
  ],
  "additionalProperties": false
}
