{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plugin://re-discipline/schemas/truth-compatibility-receipt.schema.json",
  "title": "Legacy Truth Compatibility Receipt",
  "type": "object",
  "required": [
    "schemaVersion", "transactionId", "planDigest", "truthId", "findingId",
    "sourcePath", "sourceDigest", "destination", "destinationDigest",
    "provenancePath", "provenanceDigest", "sourceText", "claim", "claimDigest",
    "legacyScope", "legacyExclusions", "atomicizationReviewDigest", "splitIndex", "splitCount", "scopePreservation", "approvedQuestionsDigest", "managerReviewBasis", "dependencyMap",
    "searchTerms", "semanticPreserved", "evidenceReachable", "scopeNotExpanded",
    "dependenciesResolve", "searchCompatibility",
    "sourceReportRatificationImported", "status", "digest"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "transactionId": {"type": "string", "pattern": "^M-[A-F0-9]{20}$"},
    "planDigest": {"$ref": "#/$defs/digest"},
    "truthId": {"type": "string", "pattern": "^T-F-[0-9]{4,}$"},
    "findingId": {"type": "string", "pattern": "^F-[0-9]{4,}$"},
    "sourcePath": {"type": "string", "pattern": "^docs/truth/.+\\.md$"},
    "sourceDigest": {"$ref": "#/$defs/digest"},
    "destination": {"type": "string", "pattern": "^docs/truth/findings/F-[0-9]{4,}\\.md$"},
    "destinationDigest": {"$ref": "#/$defs/digest"},
    "provenancePath": {"type": "string", "pattern": "^active/.+/runs/R-[0-9]{8}-[0-9]{4,}/payload/legacy/truth/.+\\.md$"},
    "provenanceDigest": {"$ref": "#/$defs/digest"},
    "sourceText": {"type": "string", "minLength": 1},
    "claim": {"type": "string", "minLength": 1, "maxLength": 500},
    "claimDigest": {"$ref": "#/$defs/digest"},
    "legacyConfidence": {"type": "string"},
    "legacyStatus": {"enum": ["superseded", "corrected"]},
    "legacyCorrection": {"type": "string"},
    "legacyScope": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "legacyExclusions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "atomicizationReviewDigest": {
      "anyOf": [
        {"$ref": "#/$defs/digest"},
        {"const": ""}
      ]
    },
    "splitIndex": {"type": "integer", "minimum": 1},
    "splitCount": {"type": "integer", "minimum": 1},
    "scopePreservation": {"const": "exact-source-provenance-no-expansion"},
    "approvedQuestionsDigest": {"$ref": "#/$defs/digest"},
    "managerReviewBasis": {"type": "string", "pattern": "^approved-migration-plan:sha256:[0-9a-f]{64}$"},
    "dependencyMap": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "searchTerms": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "semanticPreserved": {"const": true},
    "evidenceReachable": {"const": true},
    "scopeNotExpanded": {"const": true},
    "dependenciesResolve": {"const": true},
    "searchCompatibility": {"const": true},
    "sourceReportRatificationImported": {"const": false},
    "status": {"const": "passed"},
    "digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
