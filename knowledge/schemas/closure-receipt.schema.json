{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plugin://re-discipline/schemas/closure-receipt.schema.json",
  "title": "Closure Receipt",
  "type": "object",
  "required": ["schemaVersion", "campaignId", "closureJobId", "campaignRevision", "stateHeadRevision", "eventId", "archiveDestination", "archiveDigest", "truthDigests", "coverageDigest", "closedAt", "digest"],
  "properties": {
    "schemaVersion": {"const": 2},
    "campaignId": {"type": "string", "pattern": "^C-[A-Z0-9][A-Z0-9-]{0,62}$"},
    "closureJobId": {"type": "string", "minLength": 1},
    "campaignRevision": {"type": "integer", "minimum": 1},
    "stateHeadRevision": {"type": "integer", "minimum": 1},
    "eventId": {"type": "string", "pattern": "^E-[0-9]{8}-[0-9]{6}-[A-Z0-9]{6,}$"},
    "archiveDestination": {"type": "string", "pattern": "^docs/history/campaigns/[a-z0-9][a-z0-9-]{2,49}$"},
    "archiveDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "truthDigests": {"type": "object", "propertyNames": {"pattern": "^F-[0-9]{4,}$"}, "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
    "coverageDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "closedAt": {"type": "string", "format": "date-time"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
