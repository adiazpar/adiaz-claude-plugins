{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plugin://re-discipline/schemas/migration-profile-decision-submission.schema.json",
  "title": "Migration Retrieval Profile Decision Submission",
  "type": "object",
  "required": [
    "schemaVersion", "packetDigest", "sourceFingerprint", "sourcePath", "sourceDigest",
    "baselineProfileId", "baselineProfileDigest", "effectiveProfileName", "effectiveProfileDigest",
    "measurementEvidenceDigest", "decision", "explicitManagerApproval", "projectProfileActivation",
    "authority", "reviewer", "rationale", "decidedAt", "replacesDecisionDigest"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "packetDigest": {"$ref": "#/$defs/digest"},
    "sourceFingerprint": {"$ref": "#/$defs/digest"},
    "sourcePath": {"const": ".re-discipline/knowledge/retrieval-profile.json"},
    "sourceDigest": {"$ref": "#/$defs/digest"},
    "baselineProfileId": {"const": "plugin:balanced-v1"},
    "baselineProfileDigest": {"$ref": "#/$defs/digest"},
    "effectiveProfileName": {"const": "hybrid-no-rerank-v1"},
    "effectiveProfileDigest": {"$ref": "#/$defs/digest"},
    "measurementEvidenceDigest": {"$ref": "#/$defs/digest"},
    "decision": {"const": "retain-packaged-baseline"},
    "explicitManagerApproval": {"const": true},
    "projectProfileActivation": {"const": false},
    "authority": {"const": "manager"},
    "reviewer": {"type": "string", "minLength": 1},
    "rationale": {"type": "string", "minLength": 1},
    "decidedAt": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "replacesDecisionDigest": {
      "anyOf": [
        {"const": ""},
        {"$ref": "#/$defs/digest"}
      ]
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
