{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adiaz.github.io/re-discipline/schemas/project-lane-ablation-harness.schema.json",
  "title": "Disposable project retrieval benchmark staging receipt",
  "description": "Binds clean source revisions, a pre-migration disposable checkout, exact benchmark artifacts, and byte-exact indexed-source evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "kind",
    "project",
    "sourceRepositoryMutated",
    "repositories",
    "checkout",
    "tools",
    "benchmarkCommand",
    "artifacts",
    "runtime",
    "indexedSourceProof",
    "controlPlaneSubstitutions",
    "renamedPaths",
    "excludedSourcePaths",
    "negativeControls",
    "migrationGuard"
  ],
  "properties": {
    "$schema": {
      "const": "plugin://re-discipline/schemas/project-lane-ablation-harness.schema.json"
    },
    "schemaVersion": {"const": 1},
    "kind": {"const": "project-retrieval-staging-harness"},
    "project": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "sourceRepositoryMutated": {"const": false},
    "repositories": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plugin", "project"],
      "properties": {
        "plugin": {"$ref": "#/$defs/repository"},
        "project": {"$ref": "#/$defs/repository"}
      }
    },
    "checkout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposableProjectPath",
        "preservedCheckoutPath",
        "sourceRootsAlgorithm",
        "sourceRootsFileCount",
        "sourceRootsManifestSha256"
      ],
      "properties": {
        "disposableProjectPath": {"const": "disposable/project"},
        "preservedCheckoutPath": {"const": "checkout-roots"},
        "sourceRootsAlgorithm": {"const": "sorted-path-null-sha256-v1"},
        "sourceRootsFileCount": {"type": "integer", "minimum": 1},
        "sourceRootsManifestSha256": {"$ref": "#/$defs/identity"}
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "harnessScriptSha256",
        "harnessSchemaSha256",
        "pythonVersion",
        "gitVersion",
        "goVersion"
      ],
      "properties": {
        "harnessScriptSha256": {"$ref": "#/$defs/identity"},
        "harnessSchemaSha256": {"$ref": "#/$defs/identity"},
        "pythonVersion": {"type": "string", "minLength": 1},
        "gitVersion": {"type": "string", "minLength": 1},
        "goVersion": {"type": "string", "minLength": 1}
      }
    },
    "benchmarkCommand": {"$ref": "#/$defs/benchmarkCommand"},
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rawBenchmark",
        "projectionManifest",
        "profileCatalog",
        "modelManifest",
        "indexedSources",
        "currentGeneration",
        "generationDatabase",
        "finalEvalRoot",
        "projectedEvalRoot"
      ],
      "properties": {
        "rawBenchmark": {"$ref": "#/$defs/artifact"},
        "projectionManifest": {"$ref": "#/$defs/artifact"},
        "profileCatalog": {"$ref": "#/$defs/artifact"},
        "modelManifest": {"$ref": "#/$defs/artifact"},
        "indexedSources": {"$ref": "#/$defs/artifact"},
        "currentGeneration": {"$ref": "#/$defs/artifact"},
        "generationDatabase": {"$ref": "#/$defs/artifact"},
        "finalEvalRoot": {"$ref": "#/$defs/directoryArtifact"},
        "projectedEvalRoot": {"$ref": "#/$defs/directoryArtifact"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "generationId",
        "corpusFingerprint",
        "evalFingerprint",
        "projectGitRevision",
        "runtimeIdentity",
        "runtimeIdentitySha256",
        "profileCatalogSha256",
        "modelManifestSha256",
        "armCount",
        "casesPerArm"
      ],
      "properties": {
        "runId": {"type": "string", "minLength": 1},
        "generationId": {
          "type": "string",
          "pattern": "^generation-[0-9a-f]{20}$"
        },
        "corpusFingerprint": {"$ref": "#/$defs/identity"},
        "evalFingerprint": {"$ref": "#/$defs/identity"},
        "projectGitRevision": {"$ref": "#/$defs/revision"},
        "runtimeIdentity": {"type": "object"},
        "runtimeIdentitySha256": {"$ref": "#/$defs/identity"},
        "profileCatalogSha256": {"$ref": "#/$defs/identity"},
        "modelManifestSha256": {"$ref": "#/$defs/identity"},
        "armCount": {"const": 2},
        "casesPerArm": {"const": 64}
      }
    },
    "indexedSourceProof": {"$ref": "#/$defs/indexedSourceProof"},
    "controlPlaneSubstitutions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/substitution"}
    },
    "renamedPaths": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/rename"}
    },
    "excludedSourcePaths": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/safePath"}
    },
    "negativeControls": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/negativeControl"}
    },
    "migrationGuard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths", "absentBefore", "absentAfter"],
      "properties": {
        "paths": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/safePath"}
        },
        "absentBefore": {"const": true},
        "absentAfter": {"const": true}
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "safePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "tree",
        "trackedFileCount",
        "trackedManifestSha256",
        "cleanBefore",
        "cleanAfter"
      ],
      "properties": {
        "revision": {"$ref": "#/$defs/revision"},
        "tree": {"$ref": "#/$defs/revision"},
        "trackedFileCount": {"type": "integer", "minimum": 1},
        "trackedManifestSha256": {"$ref": "#/$defs/identity"},
        "cleanBefore": {"const": true},
        "cleanAfter": {"const": true}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "byteCount"],
      "properties": {
        "path": {"$ref": "#/$defs/safePath"},
        "sha256": {"$ref": "#/$defs/identity"},
        "byteCount": {"type": "integer", "minimum": 1}
      }
    },
    "directoryArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "algorithm",
        "fileCount",
        "byteCount",
        "manifestSha256"
      ],
      "properties": {
        "path": {"$ref": "#/$defs/safePath"},
        "algorithm": {"const": "sorted-path-null-sha256-v1"},
        "fileCount": {"type": "integer", "minimum": 1},
        "byteCount": {"type": "integer", "minimum": 1},
        "manifestSha256": {"$ref": "#/$defs/identity"}
      }
    },
    "benchmarkCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cwd",
        "argv",
        "sha256",
        "exitCode",
        "stdoutSha256",
        "stderrSha256"
      ],
      "properties": {
        "cwd": {"const": "plugins/re-discipline/knowledge"},
        "argv": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": {"type": "string", "minLength": 1}
        },
        "sha256": {"$ref": "#/$defs/identity"},
        "exitCode": {"enum": [0, 1]},
        "stdoutSha256": {"$ref": "#/$defs/identity"},
        "stderrSha256": {"$ref": "#/$defs/identity"}
      }
    },
    "indexedSourceProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "sourceCount",
        "byteExactCount",
        "mismatchCount",
        "pathDigestPairsSha256"
      ],
      "properties": {
        "algorithm": {"const": "sorted-path-null-sha256-v1"},
        "sourceCount": {"type": "integer", "minimum": 1},
        "byteExactCount": {"type": "integer", "minimum": 1},
        "mismatchCount": {"const": 0},
        "pathDigestPairsSha256": {"$ref": "#/$defs/identity"}
      }
    },
    "substitution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "projectPath",
        "originalSha256",
        "replacementSha256",
        "replacementSource"
      ],
      "properties": {
        "kind": {
          "enum": ["bootstrap-config", "knowledge-policy", "retrieval-profile"]
        },
        "projectPath": {"$ref": "#/$defs/safePath"},
        "originalSha256": {"$ref": "#/$defs/identity"},
        "replacementSha256": {"$ref": "#/$defs/identity"},
        "replacementSource": {"$ref": "#/$defs/safePath"}
      }
    },
    "rename": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "restorable"],
      "properties": {
        "from": {"$ref": "#/$defs/safePath"},
        "to": {"$ref": "#/$defs/safePath"},
        "restorable": {"const": true}
      }
    },
    "negativeControl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "expectedFailure", "observed", "message"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "expectedFailure": {"const": true},
        "observed": {"const": true},
        "message": {"type": "string", "minLength": 1}
      }
    }
  }
}
