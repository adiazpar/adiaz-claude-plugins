{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plugin://re-discipline/schemas/migration-operation.schema.json",
  "title": "Previewed Migration Operation",
  "type": "object",
  "required": ["id", "kind", "sources", "inputDigest"],
  "properties": {
    "id": {"type": "string", "pattern": "^MOP-[0-9a-f]{20}$"},
    "kind": {"enum": ["retain", "transform", "copy-provenance", "classify"]},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "destination": {"type": "string", "minLength": 1},
    "destinations": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "inputDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "requires": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  },
  "additionalProperties": false
}
