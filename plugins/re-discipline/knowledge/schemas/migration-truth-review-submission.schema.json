{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plugin://re-discipline/schemas/migration-truth-review-submission.schema.json",
  "title": "Migration Truth Atomicization Review Submission",
  "type": "object",
  "required": ["schemaVersion", "packetDigest", "sourcePath", "sourceDigest", "reviewer", "rationale", "claims"],
  "properties": {
    "schemaVersion": {"const": 1},
    "packetDigest": {"$ref": "#/$defs/digest"},
    "sourcePath": {"type": "string", "pattern": "^docs/truth/.+\\.md$"},
    "sourceDigest": {"$ref": "#/$defs/digest"},
    "reviewer": {"type": "string", "minLength": 1},
    "rationale": {"type": "string", "minLength": 1},
    "claims": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/$defs/claim"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "claim": {
      "type": "object",
      "required": ["sourceText", "title", "claim", "syntheticQuestions"],
      "properties": {
        "sourceText": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "claim": {"type": "string", "minLength": 1, "maxLength": 500},
        "syntheticQuestions": {
          "type": "array", "minItems": 3, "maxItems": 5, "uniqueItems": true,
          "items": {"type": "string", "pattern": "\\?$"}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
