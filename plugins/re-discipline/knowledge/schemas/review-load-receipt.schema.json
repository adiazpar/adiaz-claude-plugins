{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plugin://re-discipline/schemas/review-load-receipt.schema.json",
  "title": "Immutable Manager Review-Load Receipt",
  "type": "object",
  "required": ["schemaVersion", "reviewId", "campaignId", "packetDigest", "measurementStatus", "sessionId", "packetOrdinal", "durationSeconds", "routineRows", "attentionRows", "targetMinutesPerPacket", "targetPacketsPerSession", "ceilingDigest", "overTargetKnown", "overTarget", "granularityDecision", "digest"],
  "properties": {
    "schemaVersion": {"const": 2},
    "reviewId": {"type": "string", "pattern": "^V-[0-9]{4,}$"},
    "campaignId": {"type": "string", "pattern": "^C-[A-Z0-9][A-Z0-9-]{0,62}$"},
    "packetDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "measurementStatus": {"enum": ["measured", "legacy-unmeasured"]},
    "sessionId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "packetOrdinal": {"type": "integer", "minimum": 1},
    "startedAt": {"type": "string", "format": "date-time"},
    "completedAt": {"type": "string", "format": "date-time"},
    "durationSeconds": {"type": "integer", "minimum": 0},
    "routineRows": {"type": "integer", "minimum": 0},
    "attentionRows": {"type": "integer", "minimum": 0},
    "targetMinutesPerPacket": {"type": "integer", "minimum": 1, "maximum": 240},
    "targetPacketsPerSession": {"type": "integer", "minimum": 1, "maximum": 100},
    "ceilingDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "overTargetKnown": {"type": "boolean"},
    "overTarget": {"type": "boolean"},
    "granularityDecision": {"enum": ["retain", "coarsen", "unmeasured"]},
    "granularityRationale": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"measurementStatus": {"const": "measured"}}},
      "then": {
        "required": ["startedAt", "completedAt"],
        "properties": {
          "durationSeconds": {"minimum": 1},
          "overTargetKnown": {"const": true},
          "granularityDecision": {"enum": ["retain", "coarsen"]}
        }
      }
    },
    {
      "if": {"properties": {"measurementStatus": {"const": "measured"}, "overTarget": {"const": true}}, "required": ["measurementStatus", "overTarget"]},
      "then": {
        "required": ["granularityRationale"],
        "properties": {"granularityDecision": {"const": "coarsen"}}
      }
    },
    {
      "if": {"properties": {"measurementStatus": {"const": "measured"}, "overTarget": {"const": false}}, "required": ["measurementStatus", "overTarget"]},
      "then": {"properties": {"granularityDecision": {"const": "retain"}}}
    },
    {
      "if": {"properties": {"measurementStatus": {"const": "legacy-unmeasured"}}},
      "then": {
        "required": ["granularityRationale"],
        "not": {"anyOf": [{"required": ["startedAt"]}, {"required": ["completedAt"]}]},
        "properties": {
          "durationSeconds": {"const": 0},
          "overTargetKnown": {"const": false},
          "overTarget": {"const": false},
          "granularityDecision": {"const": "unmeasured"}
        }
      }
    }
  ],
  "additionalProperties": false
}
