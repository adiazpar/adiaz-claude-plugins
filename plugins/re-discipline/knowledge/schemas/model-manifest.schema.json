{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plugin://re-discipline/schemas/model-manifest.schema.json",
  "title": "Re-Discipline local model manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runtime", "models", "externalModelPolicy"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "version", "sqliteDriver", "numericalBackend", "tieBreaker"],
      "properties": {
        "implementation": {"const": "re-discipline-knowledge-go"},
        "version": {"type": "string"},
        "sqliteDriver": {"type": "string"},
        "numericalBackend": {"const": "fixed-int64-v1"},
        "tieBreaker": {"type": "string"}
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "revision", "implementation", "specFile", "specSha256", "artifactFile", "artifactSha256", "license", "dimensions", "networkRequired"],
        "properties": {
          "id": {"const": "builtin:glove-6b-50d-top50k-q8-v1"},
          "role": {"const": "embedding"},
          "revision": {"const": "1"},
          "implementation": {"const": "bundled-local"},
          "specFile": {"const": "models/specs/glove-6b-50d-top50k-q8-v1.json"},
          "specSha256": {"const": "2cdb94f94891907db8bdba40148dc6052b7d2cddacf868bb563092255ef1319a"},
          "artifactFile": {"const": "models/artifacts/glove-6b-50d-top50k-q8-v1.bin"},
          "artifactSha256": {"const": "fb108eef095f00bcc06a38e10d7f9671d9e6664ab79ae8a2c1cef5b31375b2ab"},
          "license": {"const": "PDDL-1.0"},
          "dimensions": {"const": 50},
          "normalization": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "networkRequired": {"const": false}
        }
      }
    },
    "externalModelPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["networkDownloads", "requireManifestEntry", "requireArtifactSha256", "requireLocalPathGrant"],
      "properties": {
        "networkDownloads": {"const": false},
        "requireManifestEntry": {"const": true},
        "requireArtifactSha256": {"const": true},
        "requireLocalPathGrant": {"const": true}
      }
    }
  }
}
