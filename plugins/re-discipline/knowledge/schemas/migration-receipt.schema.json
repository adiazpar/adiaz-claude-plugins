{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plugin://re-discipline/schemas/migration-receipt.schema.json",
  "title": "Migration Certification Receipt",
  "type": "object",
  "required": ["schemaVersion", "id", "planId", "approvedPreviewDigest", "sourceInventoryDigest", "operationDigests", "liveCampaignCertification", "shadowIndexDigest", "packageAuditDigest", "hostConformance", "ratifiedAt", "ratifiedBy", "digest"],
  "properties": {
    "schemaVersion": {"const": 2},
    "id": {"type": "string", "minLength": 1},
    "planId": {"type": "string", "minLength": 1},
    "approvedPreviewDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "sourceInventoryDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "operationDigests": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
    "liveCampaignCertification": {"type": "object", "additionalProperties": {"enum": ["traversal-verified", "blocked"]}},
    "shadowIndexDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "packageAuditDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "hostConformance": {"type": "object", "additionalProperties": {"type": "string"}},
    "ratifiedAt": {"type": "string", "format": "date-time"},
    "ratifiedBy": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
