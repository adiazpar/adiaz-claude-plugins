{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plugin://re-discipline/schemas/migration-receipt.schema.json",
  "title": "Migration Certification Receipt",
  "type": "object",
  "required": [
    "schemaVersion", "transactionId", "planDigest", "state", "structural",
    "semanticTraversal", "retrievalContext", "hostParity", "requiredGates",
    "gateReceipts", "sourceStateHead", "destinationStateHead", "pluginVersion",
    "schemaVersions", "inventoryDigest", "coverageDigest", "physicalEquivalence",
    "benchmarkFingerprint", "calibrationFingerprint", "blindedAgentEvaluationFingerprint",
    "mcpConformanceFingerprint", "cliConformanceFingerprint", "claudeHostFingerprint",
    "codexHostFingerprint", "knownLimitations", "finalManagerDecision",
    "blockers", "candidate", "digest"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "transactionId": {"type": "string", "pattern": "^M-[A-F0-9]{20}$"},
    "planDigest": {"$ref": "#/$defs/digest"},
    "state": {"const": "physically-reorganized"},
    "structural": {"type": "boolean"},
    "semanticTraversal": {"type": "boolean"},
    "retrievalContext": {"type": "boolean"},
    "hostParity": {"type": "boolean"},
    "requiredGates": {
      "type": "array",
      "items": {"enum": ["structural", "semantic-traversal", "retrieval-context", "host-parity"]},
      "uniqueItems": true
    },
    "gateReceipts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["schemaVersion", "gate", "passed", "artifact", "artifactDigest", "reviewer", "timestamp", "digest"],
        "properties": {
          "schemaVersion": {"const": 1},
          "gate": {"enum": ["structural", "semantic-traversal", "retrieval-context", "host-parity"]},
          "passed": {"type": "boolean"},
          "artifact": {"type": "string", "minLength": 1, "maxLength": 1000, "pattern": "^(?![A-Za-z]:|/|\\\\|.*(?:^|/)\\.\\.(?:/|$)).+"},
          "artifactDigest": {"$ref": "#/$defs/digest"},
          "reviewer": {"type": "string", "minLength": 1},
          "timestamp": {"type": "string", "format": "date-time"},
          "digest": {"$ref": "#/$defs/digest"}
        },
        "additionalProperties": false
      }
    },
    "sourceStateHead": {"$ref": "#/$defs/digest"},
    "destinationStateHead": {"$ref": "#/$defs/digestOrEmpty"},
    "pluginVersion": {"type": "string", "pattern": "^0\\.8\\.[0-9]+$"},
    "schemaVersions": {
      "type": "object",
      "required": ["migration", "campaign", "bootstrap", "knowledge"],
      "additionalProperties": {"type": "integer", "minimum": 1}
    },
    "inventoryDigest": {"$ref": "#/$defs/digest"},
    "coverageDigest": {"$ref": "#/$defs/digestOrEmpty"},
    "physicalEquivalence": {
      "type": "object",
      "required": ["plannedDestinations", "byteExact", "transformed", "retainedInPlace", "receiptDigest"],
      "properties": {
        "plannedDestinations": {"type": "integer", "minimum": 0},
        "byteExact": {"type": "integer", "minimum": 0},
        "transformed": {"type": "integer", "minimum": 0},
        "retainedInPlace": {"type": "integer", "minimum": 0},
        "receiptDigest": {"$ref": "#/$defs/digestOrEmpty"}
      },
      "additionalProperties": false
    },
    "benchmarkFingerprint": {"$ref": "#/$defs/digestOrEmpty"},
    "calibrationFingerprint": {"$ref": "#/$defs/digestOrEmpty"},
    "blindedAgentEvaluationFingerprint": {"$ref": "#/$defs/digestOrEmpty"},
    "mcpConformanceFingerprint": {"$ref": "#/$defs/digestOrEmpty"},
    "cliConformanceFingerprint": {"$ref": "#/$defs/digestOrEmpty"},
    "claudeHostFingerprint": {"$ref": "#/$defs/digestOrEmpty"},
    "codexHostFingerprint": {"$ref": "#/$defs/digestOrEmpty"},
    "knownLimitations": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "finalManagerDecision": {"const": "pending-ratification"},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "candidate": {"type": "boolean"},
    "digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "digestOrEmpty": {"type": "string", "pattern": "^(?:sha256:[0-9a-f]{64})?$"}
  },
  "additionalProperties": false
}
