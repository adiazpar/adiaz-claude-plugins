{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plugin://re-discipline/schemas/campaign-chronology.schema.json",
  "title": "Campaign Historical Chronology",
  "type": "object",
  "required": ["schemaVersion", "campaignId", "stages", "records", "digest"],
  "properties": {
    "schemaVersion": {"const": 1},
    "campaignId": {"$ref": "#/$defs/campaignId"},
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/stage"}
    },
    "records": {
      "type": "array",
      "items": {"$ref": "#/$defs/record"}
    },
    "digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "campaignId": {
      "type": "string",
      "pattern": "^C-[A-Z0-9][A-Z0-9-]{0,62}$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$"
    },
    "stage": {
      "type": "object",
      "required": ["id", "startDate", "endDate", "title", "summary", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "startDate": {"$ref": "#/$defs/date"},
        "endDate": {"$ref": "#/$defs/date"},
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "status": {"enum": ["historical", "migration", "pending"]},
        "sourceCampaignIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/campaignId"}
        },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "record": {
      "type": "object",
      "required": ["historicalDate", "kind", "sourceHandle", "targetHandle"],
      "properties": {
        "historicalDate": {"$ref": "#/$defs/date"},
        "kind": {"enum": ["campaign", "work-item", "run", "finding", "evidence", "intake", "review", "review-load", "review-session", "event"]},
        "sourceHandle": {"type": "string", "minLength": 1},
        "targetHandle": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
