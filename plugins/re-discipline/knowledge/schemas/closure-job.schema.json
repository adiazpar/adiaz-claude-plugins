{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plugin://re-discipline/schemas/closure-job.schema.json",
  "title": "Resumable Closure Job",
  "type": "object",
  "required": ["schemaVersion", "id", "createdAt", "updatedAt", "revision", "createdBy", "updatedBy", "digest", "correlationId", "campaignId", "stage", "status", "frozenCampaignRevision", "projectionFindingIds"],
  "properties": {
    "schemaVersion": {"const": 2},
    "id": {"type": "string", "minLength": 1},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"},
    "revision": {"type": "integer", "minimum": 1},
    "createdBy": {"type": "string", "minLength": 1},
    "updatedBy": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "correlationId": {"type": "string", "minLength": 1},
    "campaignId": {"type": "string", "pattern": "^C-[A-Z0-9][A-Z0-9-]{0,62}$"},
    "stage": {"enum": ["inventory", "coverage", "normalize", "reconcile", "decide", "project", "verify", "archive", "finalize"]},
    "status": {"enum": ["running", "blocked", "verified", "completed", "reopened"]},
    "frozenCampaignRevision": {"type": "integer", "minimum": 1},
    "projectionFindingIds": {"type": "array", "items": {"type": "string", "pattern": "^F-[0-9]{4,}$"}, "uniqueItems": true},
    "archiveDestination": {"type": "string"},
    "truthDigests": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
    "projectionDigests": {"type": "object", "propertyNames": {"type": "string", "minLength": 1}, "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
    "coverage": {"$ref": "closure-coverage.schema.json"},
    "archiveDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "blockers": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
