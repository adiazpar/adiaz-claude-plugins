{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plugin://re-discipline/schemas/decision-receipt.schema.json",
  "title": "Finding Decision Receipt",
  "type": "object",
  "required": ["schemaVersion", "id", "reviewId", "reviewer", "authority", "findingId", "findingRevision", "action", "rationale", "createdAt", "eventIds", "digest"],
  "properties": {
    "schemaVersion": {"const": 2},
    "id": {"type": "string", "minLength": 1},
    "reviewId": {"type": "string", "pattern": "^V-[0-9]{4,}$"},
    "reviewer": {"type": "string", "minLength": 1},
    "authority": {"enum": ["manager", "reviewer"]},
    "findingId": {"type": "string", "pattern": "^F-[0-9]{4,}$"},
    "findingRevision": {"type": "integer", "minimum": 1},
    "action": {"enum": ["ratify", "reject", "challenge", "merge", "split", "hold", "correct-grade", "supersede"]},
    "evidenceCorrection": {"enum": ["direct", "inferred", "reported", "unknown"]},
    "projection": {"enum": ["none", "campaign", "truth", "history", "backlog", "playbook", "maintained", "archive", "rejected"]},
    "rationale": {"type": "string", "minLength": 1},
    "createdAt": {"type": "string", "format": "date-time"},
    "eventIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
