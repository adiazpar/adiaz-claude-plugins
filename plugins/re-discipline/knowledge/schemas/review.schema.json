{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plugin://re-discipline/schemas/review.schema.json",
  "title": "Immutable Manager Review",
  "type": "object",
  "required": ["schemaVersion", "id", "createdAt", "updatedAt", "revision", "createdBy", "updatedBy", "digest", "correlationId", "campaignId", "reviewer", "authority", "intakeId", "intakeRevision", "packetDigest", "decisions"],
  "properties": {
    "schemaVersion": {"const": 2},
    "id": {"type": "string", "pattern": "^V-[0-9]{4,}$"},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"},
    "revision": {"const": 1},
    "createdBy": {"type": "string", "minLength": 1},
    "updatedBy": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "correlationId": {"type": "string", "minLength": 1},
    "campaignId": {"type": "string", "pattern": "^C-[A-Z0-9][A-Z0-9-]{0,62}$"},
    "reviewer": {"type": "string", "minLength": 1},
    "authority": {"enum": ["manager", "reviewer"]},
    "intakeId": {"type": "string", "pattern": "^I-[0-9]{4,}$"},
    "intakeRevision": {"type": "integer", "minimum": 1},
    "packetDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["findingId", "findingRevision", "action", "rationale"],
        "properties": {
          "findingId": {"type": "string", "pattern": "^F-[0-9]{4,}$"},
          "findingRevision": {"type": "integer", "minimum": 1},
          "action": {"enum": ["ratify", "reject", "challenge", "merge", "split", "hold", "correct-grade", "supersede"]},
          "evidenceCorrection": {"enum": ["direct", "inferred", "reported", "unknown"]},
          "projection": {"enum": ["none", "campaign", "truth", "history", "backlog", "playbook", "maintained", "archive", "rejected"]},
          "rationale": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "unresolvedConflicts": {"type": "array", "items": {"type": "string"}},
    "priorReviewId": {"type": "string", "pattern": "^V-[0-9]{4,}$"},
    "resultingEventIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "resultingRecordIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "additionalProperties": false
}
