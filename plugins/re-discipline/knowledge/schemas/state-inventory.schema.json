{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plugin://re-discipline/schemas/state-inventory.schema.json",
  "title": "Canonical State Byte Inventory",
  "type": "object",
  "required": ["schemaVersion", "headRevision", "entries", "digest"],
  "properties": {
    "schemaVersion": {"const": 2},
    "headRevision": {"type": "integer", "minimum": 0},
    "entries": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["path", "contentDigest"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?:(?:active|docs/(?:truth|history/campaigns))/[^\\\\]+|\\.re-discipline/migration/0\\.8/certification\\.json)$"
          },
          "contentDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
