{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plugin://re-discipline/schemas/migration-truth-conflict-packet.schema.json",
  "title": "Migration Truth Atomicization Conflict Packet",
  "type": "object",
  "required": ["schemaVersion", "project", "projectIdentity", "sourceFingerprint", "conflicts", "digest"],
  "properties": {
    "schemaVersion": {"const": 1},
    "project": {"type": "string", "minLength": 1},
    "projectIdentity": {
      "anyOf": [
        {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        {"const": "missing"}
      ]
    },
    "sourceFingerprint": {"$ref": "#/$defs/digest"},
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "sourcePath", "sourceDigest", "title", "explicitClaims", "sourceCoverageText", "legacyDependencies", "requiredResolution", "digest"],
        "properties": {
          "code": {"enum": ["truth-claim-boundary-unproven", "truth-multi-claim", "truth-claim-not-atomic"]},
          "sourcePath": {"type": "string", "pattern": "^docs/truth/.+\\.md$"},
          "sourceDigest": {"$ref": "#/$defs/digest"},
          "title": {"type": "string"},
          "explicitClaims": {"type": "array", "items": {"type": "string"}},
          "sourceCoverageText": {"type": "string", "minLength": 1},
          "legacyDependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "requiredResolution": {"type": "string", "minLength": 1},
          "digest": {"$ref": "#/$defs/digest"}
        },
        "additionalProperties": false
      }
    },
    "digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
