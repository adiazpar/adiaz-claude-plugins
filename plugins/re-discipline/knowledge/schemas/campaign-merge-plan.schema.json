{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plugin://re-discipline/schemas/campaign-merge-plan.schema.json",
  "title": "Campaign Merge Plan",
  "type": "object",
  "required": ["schemaVersion", "id", "expectedHead", "spec", "sources", "mappings", "artifacts", "counts", "chronologyDigest", "idMapDigest", "digest"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^campaign-merge-[0-9a-f]{20}$"},
    "expectedHead": {"$ref": "#/$defs/stateHead"},
    "spec": {"$ref": "#/$defs/mergeSpec"},
    "sources": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/sourceSnapshot"}
    },
    "mappings": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/idMapping"}
    },
    "artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifactMapping"}
    },
    "counts": {"$ref": "#/$defs/counts"},
    "chronologyDigest": {"$ref": "#/$defs/digest"},
    "idMapDigest": {"$ref": "#/$defs/digest"},
    "digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "campaignId": {
      "type": "string",
      "pattern": "^C-[A-Z0-9][A-Z0-9-]{0,62}$"
    },
    "campaignSlug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,49}$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$"
    },
    "stateHead": {
      "type": "object",
      "required": ["schemaVersion", "revision", "stateDigest", "inventoryDigest", "digest"],
      "properties": {
        "schemaVersion": {"type": "integer", "minimum": 1},
        "revision": {"type": "integer", "minimum": 0},
        "eventId": {"type": "string"},
        "eventDigest": {"$ref": "#/$defs/digest"},
        "stateDigest": {"$ref": "#/$defs/digest"},
        "inventoryDigest": {"$ref": "#/$defs/digest"},
        "transactionId": {"type": "string"},
        "eventJournal": {"type": "string"},
        "updatedAt": {"type": "string", "format": "date-time"},
        "digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "sourceSelector": {
      "type": "object",
      "required": ["campaignId", "campaignSlug"],
      "properties": {
        "campaignId": {"$ref": "#/$defs/campaignId"},
        "campaignSlug": {"$ref": "#/$defs/campaignSlug"}
      },
      "additionalProperties": false
    },
    "chronologyEntry": {
      "type": "object",
      "required": ["id", "startDate", "endDate", "title", "summary", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "startDate": {"$ref": "#/$defs/date"},
        "endDate": {"$ref": "#/$defs/date"},
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "status": {"enum": ["historical", "migration", "pending"]},
        "sourceCampaignIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/campaignId"}
        },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "mergeSpec": {
      "type": "object",
      "required": ["targetCampaignId", "targetSlug", "title", "objective", "owner", "permittedManagers", "mergedAt", "sources", "chronology"],
      "properties": {
        "targetCampaignId": {"$ref": "#/$defs/campaignId"},
        "targetSlug": {"$ref": "#/$defs/campaignSlug"},
        "title": {"type": "string", "minLength": 1},
        "objective": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "permittedManagers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "mergedAt": {"type": "string", "format": "date-time"},
        "sources": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sourceSelector"}
        },
        "chronology": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/chronologyEntry"}
        }
      },
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "required": ["campaigns", "workItems", "runs", "returnedRuns", "abortedRuns", "findings", "intakes", "reviews", "events", "artifacts", "artifactBytes"],
      "properties": {
        "campaigns": {"type": "integer", "minimum": 0},
        "workItems": {"type": "integer", "minimum": 0},
        "runs": {"type": "integer", "minimum": 0},
        "returnedRuns": {"type": "integer", "minimum": 0},
        "abortedRuns": {"type": "integer", "minimum": 0},
        "findings": {"type": "integer", "minimum": 0},
        "intakes": {"type": "integer", "minimum": 0},
        "reviews": {"type": "integer", "minimum": 0},
        "events": {"type": "integer", "minimum": 0},
        "artifacts": {"type": "integer", "minimum": 0},
        "artifactBytes": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "sourceSnapshot": {
      "type": "object",
      "required": ["campaign", "treeDigest", "counts"],
      "properties": {
        "campaign": {"$ref": "campaign.schema.json"},
        "treeDigest": {"$ref": "#/$defs/digest"},
        "counts": {"$ref": "#/$defs/counts"}
      },
      "additionalProperties": false
    },
    "idMapping": {
      "type": "object",
      "required": ["kind", "sourceCampaignId", "sourceCampaignSlug", "sourceId", "sourcePath", "sourceDigest", "targetId", "targetPath", "historicalDate"],
      "properties": {
        "kind": {"enum": ["campaign", "work-item", "run", "finding", "evidence", "intake", "review", "review-load", "review-session", "event"]},
        "sourceCampaignId": {"$ref": "#/$defs/campaignId"},
        "sourceCampaignSlug": {"$ref": "#/$defs/campaignSlug"},
        "sourceId": {"type": "string", "minLength": 1},
        "sourcePath": {"type": "string", "minLength": 1},
        "sourceRevision": {"type": "integer", "minimum": 1},
        "sourceDigest": {"$ref": "#/$defs/digest"},
        "sourceCorrelationId": {"type": "string", "minLength": 1},
        "targetId": {"type": "string", "minLength": 1},
        "targetPath": {"type": "string", "minLength": 1},
        "historicalDate": {"$ref": "#/$defs/date"}
      },
      "additionalProperties": false
    },
    "artifactMapping": {
      "type": "object",
      "required": ["sourceCampaignId", "sourceCampaignSlug", "sourcePath", "targetPath", "sha256", "size", "mode"],
      "properties": {
        "sourceCampaignId": {"$ref": "#/$defs/campaignId"},
        "sourceCampaignSlug": {"$ref": "#/$defs/campaignSlug"},
        "sourcePath": {"type": "string", "minLength": 1},
        "targetPath": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/digest"},
        "size": {"type": "integer", "minimum": 0},
        "mode": {"type": "integer", "minimum": 0, "maximum": 511}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
