{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plugin://re-discipline/schemas/retrieval-profile.schema.json",
  "title": "Re-Discipline retrieval profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profileId", "description", "effectiveProfiles"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "profileId": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?::[a-z0-9]+(?:-[a-z0-9]+)*)?$"},
    "description": {"type": "string", "minLength": 1, "maxLength": 2000},
    "baseProfile": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?::[a-z0-9]+(?:-[a-z0-9]+)*)?$"},
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "explicitUserApproval", "approvedAt", "profileDigest", "benchmarkMatrixDigest", "corpusFingerprint", "evalFingerprint", "modelFingerprint", "runtimeContract", "calibrationReportDigest", "candidateDigest"],
      "properties": {
        "decision": {"const": "promoted"},
        "explicitUserApproval": {"const": true},
        "approvedAt": {"type": "string", "format": "date-time"},
        "profileDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "benchmarkMatrixDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "corpusFingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "evalFingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "modelFingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "runtimeContract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["implementation", "version", "goVersion", "compiledBuildId", "sqliteDriver", "sqliteVersion", "sqliteBuild", "numericalBackend", "tieBreaker"],
          "properties": {
            "implementation": {"const": "re-discipline-knowledge-go"},
            "version": {"const": "0.7.0"},
            "goVersion": {"type": "string", "minLength": 1},
            "compiledBuildId": {"const": "source-contract-0.7.0"},
            "sqliteDriver": {"const": "modernc.org/sqlite@v1.54.0"},
            "sqliteVersion": {"type": "string", "minLength": 1},
            "sqliteBuild": {"type": "string", "minLength": 1},
            "numericalBackend": {"const": "fixed-int64-v1"},
            "tieBreaker": {"const": "score-desc,path-asc,start-line-asc,chunk-id-asc"}
          }
        },
        "calibrationReportDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "candidateDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "effectiveProfiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "requires", "lanes", "weights", "rrfK", "rerankDepth", "maxPerDocument", "packing", "benchmark"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "description": {"type": "string", "maxLength": 2000},
          "requires": {
            "type": "object",
            "additionalProperties": false,
            "required": ["embedding", "reranker"],
            "properties": {
              "embedding": {"type": ["string", "null"]},
              "reranker": {"type": ["string", "null"]}
            }
          },
          "lanes": {
            "type": "array",
            "uniqueItems": true,
            "items": {"enum": ["exact", "fts", "graph", "dense", "rerank"]}
          },
          "weights": {
            "type": "object",
            "additionalProperties": false,
            "required": ["exact", "fts", "graph", "dense"],
            "properties": {
              "exact": {"type": "integer", "minimum": 0, "maximum": 100},
              "fts": {"type": "integer", "minimum": 0, "maximum": 100},
              "graph": {"type": "integer", "minimum": 0, "maximum": 100},
              "dense": {"type": "integer", "minimum": 0, "maximum": 100}
            }
          },
          "rrfK": {"type": "integer", "minimum": 1, "maximum": 1000},
          "rerankDepth": {"type": "integer", "minimum": 0, "maximum": 100},
          "maxPerDocument": {"type": "integer", "minimum": 1, "maximum": 20},
          "packing": {
            "type": "object",
            "additionalProperties": false,
            "required": ["maxPassages", "maxBytes"],
            "properties": {
              "maxPassages": {"type": "integer", "minimum": 1, "maximum": 50},
              "maxBytes": {"type": "integer", "minimum": 4096, "maximum": 262144}
            }
          },
          "benchmark": {
            "type": "object",
            "additionalProperties": false,
            "required": ["suite", "digest", "status"],
            "allOf": [
              {
                "if": {
                  "properties": {"status": {"const": "passed"}},
                  "required": ["status"]
                },
                "then": {
                  "required": ["evaluatedAt", "evalFingerprint", "corpusFingerprint", "modelFingerprint", "runtimeFingerprint"]
                }
              }
            ],
            "properties": {
              "suite": {"type": "string"},
              "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
              "status": {"enum": ["passed", "shadow", "stale", "failed"]},
              "evaluatedAt": {"type": "string", "format": "date-time"},
              "evalFingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
              "corpusFingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
              "modelFingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
              "runtimeFingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
              "chunkerVersion": {"type": "string", "minLength": 1, "maxLength": 100},
              "parserVersion": {"type": "string", "minLength": 1, "maxLength": 100},
              "ratifiedHardNegativeHits": {"type": "integer", "minimum": 0},
              "ratifiedAbstentionAccuracy": {"type": "number", "minimum": 0, "maximum": 1}
            }
          }
        }
      }
    }
  }
}
