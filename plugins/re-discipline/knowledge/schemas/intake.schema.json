{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plugin://re-discipline/schemas/intake.schema.json",
  "title": "Curator Intake Batch",
  "type": "object",
  "required": ["schemaVersion", "id", "createdAt", "updatedAt", "revision", "createdBy", "updatedBy", "digest", "correlationId", "campaignId", "sourceRuns", "candidateFindingIds", "coverage", "triage", "status"],
  "properties": {
    "schemaVersion": {"const": 2},
    "id": {"type": "string", "pattern": "^I-[0-9]{4,}$"},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"},
    "revision": {"type": "integer", "minimum": 1},
    "createdBy": {"type": "string", "minLength": 1},
    "updatedBy": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "correlationId": {"type": "string", "minLength": 1},
    "campaignId": {"type": "string", "pattern": "^C-[A-Z0-9][A-Z0-9-]{0,62}$"},
    "sourceRuns": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fileHandle"}},
    "candidateFindingIds": {"type": "array", "items": {"type": "string", "pattern": "^F-[0-9]{4,}$"}, "uniqueItems": true},
    "proposedDuplicates": {"type": "array", "items": {"type": "array", "minItems": 2, "items": {"type": "string"}}},
    "proposedMerges": {"type": "array", "items": {"type": "array", "minItems": 2, "items": {"type": "string"}}},
    "conflicts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "spawnedWorkItems": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "retentionDecisions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "coverage": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/coverage"}},
    "uncertainties": {"type": "array", "items": {"type": "string"}},
    "requestedDecisions": {"type": "array", "items": {"type": "string"}},
    "triage": {"type": "object", "additionalProperties": {"enum": ["routine", "attention"]}},
    "status": {"enum": ["draft", "submitted", "reviewed", "superseded"]}
  },
  "$defs": {
    "fileHandle": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "required": ["sourceHandle", "disposition"],
      "properties": {
        "sourceHandle": {"type": "string", "minLength": 1},
        "disposition": {"enum": ["candidate-finding", "duplicate", "non-claim", "unresolved", "out-of-scope"]},
        "targetId": {"type": "string"},
        "rationale": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
