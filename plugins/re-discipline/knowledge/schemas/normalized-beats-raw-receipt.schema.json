{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plugin://re-discipline/schemas/normalized-beats-raw-receipt.schema.json",
  "title": "Ratified normalized-finding archive gate receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "status", "ratifiedAt", "ratifiedBy", "decisionCorrelationId", "decisionIdempotencyKey", "evaluatedAt", "suiteId", "suiteDigest", "reportRunId", "reportPath", "reportDigest", "reportContentDigest", "pairedEvaluationDigest", "questionsDigest", "contractDigest", "generation", "binding", "previousSettingsDigest", "resultingSettingsDigest", "resultingSettings", "caseCount", "developmentCases", "developmentManagerCases", "developmentDrafterCases", "developmentAbstentionCases", "holdoutCases", "holdoutManagerCases", "holdoutDrafterCases", "holdoutAbstentionCases", "normalizedRecall", "rawRecall", "abstentionAccuracy", "findingHandleAccuracy", "evidenceHandleAccuracy", "sourceClassAccuracy", "reviewStateAccuracy", "validityAccuracy", "vocabularyDisjointRate", "durabilityLabelAccuracy", "hardNegativeHits", "deterministicReplayRate", "normalizedMedianTokens", "rawMedianTokens", "passed", "digest"],
  "properties": {
    "schemaVersion": {"const": 2},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "status": {"const": "ratified"},
    "ratifiedAt": {"type": "string", "format": "date-time"},
    "ratifiedBy": {"type": "string", "minLength": 1},
    "decisionCorrelationId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "decisionIdempotencyKey": {"type": "string", "minLength": 1, "maxLength": 256},
    "evaluatedAt": {"type": "string", "format": "date-time"},
    "suiteId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "suiteDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "reportRunId": {"type": "string", "pattern": "^normalized-vs-raw-[0-9]{8}T[0-9]{6}\\.[0-9]{9}Z$"},
    "reportPath": {"type": "string", "pattern": "^\\.re-discipline/knowledge/measurements/normalized-vs-raw/normalized-vs-raw-[0-9]{8}T[0-9]{6}\\.[0-9]{9}Z/report\\.json$"},
    "reportDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "reportContentDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "pairedEvaluationDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "questionsDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "contractDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "corpusFingerprint", "modelFingerprint", "runtimeFingerprint", "project", "worktree", "gitRevision", "dirtyFingerprint", "parserVersion", "chunkerVersion", "createdAt"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "corpusFingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "modelFingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "runtimeFingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "project": {"type": "string", "minLength": 1},
        "worktree": {"type": "string", "minLength": 1},
        "gitRevision": {"type": "string"},
        "dirtyFingerprint": {"type": "string"},
        "parserVersion": {"type": "string", "minLength": 1},
        "chunkerVersion": {"type": "string", "minLength": 1},
        "createdAt": {"type": "string", "format": "date-time"}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["corpusFingerprint", "profileIdentity", "runtimeFingerprint", "findingFormat", "identifierAnalyzer"],
      "properties": {
        "corpusFingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "profileIdentity": {"type": "string", "minLength": 1},
        "runtimeFingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "findingFormat": {"type": "string", "minLength": 1},
        "identifierAnalyzer": {"type": "string", "minLength": 1}
      }
    },
    "previousSettingsDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "resultingSettingsDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "resultingSettings": {"$ref": "knowledge-settings.schema.json"},
    "caseCount": {"type": "integer", "minimum": 48},
    "developmentCases": {"type": "integer", "minimum": 24},
    "developmentManagerCases": {"type": "integer", "minimum": 6},
    "developmentDrafterCases": {"type": "integer", "minimum": 6},
    "developmentAbstentionCases": {"type": "integer", "minimum": 4},
    "holdoutCases": {"type": "integer", "minimum": 24},
    "holdoutManagerCases": {"type": "integer", "minimum": 6},
    "holdoutDrafterCases": {"type": "integer", "minimum": 6},
    "holdoutAbstentionCases": {"type": "integer", "minimum": 4},
    "normalizedRecall": {"type": "number", "minimum": 0, "maximum": 1},
    "rawRecall": {"type": "number", "minimum": 0, "maximum": 1},
    "abstentionAccuracy": {"const": 1},
    "findingHandleAccuracy": {"const": 1},
    "evidenceHandleAccuracy": {"const": 1},
    "sourceClassAccuracy": {"const": 1},
    "reviewStateAccuracy": {"const": 1},
    "validityAccuracy": {"const": 1},
    "vocabularyDisjointRate": {"const": 1},
    "durabilityLabelAccuracy": {"const": 1},
    "hardNegativeHits": {"const": 0},
    "deterministicReplayRate": {"const": 1},
    "normalizedMedianTokens": {"type": "integer", "minimum": 1},
    "rawMedianTokens": {"type": "integer", "minimum": 1},
    "passed": {"const": true},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
