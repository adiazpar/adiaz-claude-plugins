{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plugin://re-discipline/schemas/review-packet.schema.json",
  "title": "Manager Review Packet",
  "type": "object",
  "required": ["schemaVersion", "id", "campaignId", "intakeId", "intakeRevision", "rows", "coverageComplete", "createdAt", "digest"],
  "properties": {
    "schemaVersion": {"const": 2},
    "id": {"type": "string", "minLength": 1},
    "campaignId": {"type": "string", "pattern": "^C-[A-Z0-9][A-Z0-9-]{0,62}$"},
    "intakeId": {"type": "string", "pattern": "^I-[0-9]{4,}$"},
    "intakeRevision": {"type": "integer", "minimum": 1},
    "rows": {
      "type": "array",
      "minItems": 0,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["findingId", "findingRevision", "claim", "evidenceGrade", "triage", "conflicted", "recommendation", "evidenceHandles"],
        "properties": {
          "findingId": {"type": "string", "pattern": "^F-[0-9]{4,}$"},
          "findingRevision": {"type": "integer", "minimum": 1},
          "claim": {"type": "string", "minLength": 1},
          "evidenceGrade": {"enum": ["direct", "inferred", "reported", "unknown"]},
          "triage": {"enum": ["routine", "attention"]},
          "conflicted": {"type": "boolean"},
          "recommendation": {"type": "string", "minLength": 1},
          "evidenceHandles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^evidence:F-[0-9]{4,}:[0-9a-f]{20}$"}}
        },
        "additionalProperties": false
      }
    },
    "coverageComplete": {"type": "boolean"},
    "createdAt": {"type": "string", "format": "date-time"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
