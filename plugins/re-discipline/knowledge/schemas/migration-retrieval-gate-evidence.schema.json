{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plugin://re-discipline/schemas/migration-retrieval-gate-evidence.schema.json",
  "title": "Migration Retrieval Gate Evidence",
  "type": "object",
  "required": [
    "schemaVersion", "suite", "benchmark", "calibration",
    "candidateProfile", "blindedEvaluation", "resultDigest"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "suite": {"const": "migration-retrieval-certification-v1"},
    "benchmark": {"$ref": "#/$defs/artifact"},
    "calibration": {"$ref": "#/$defs/artifact"},
    "candidateProfile": {"$ref": "#/$defs/artifact"},
    "blindedEvaluation": {"$ref": "#/$defs/artifact"},
    "resultDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "required": ["path", "digest"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 1000, "pattern": "^(?![A-Za-z]:|/|\\\\|.*(?:^|/)\\.\\.(?:/|$)).+"},
        "digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
