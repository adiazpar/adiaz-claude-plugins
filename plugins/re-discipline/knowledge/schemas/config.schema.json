{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plugin://re-discipline/schemas/config.schema.json",
  "title": "Re-Discipline bootstrap configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "knowledgeDirectory", "memory", "knowledge"],
  "properties": {
    "schemaVersion": {"const": 2},
    "knowledgeDirectory": {"const": "knowledge"},
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "writePolicy"],
      "properties": {
        "mode": {"enum": ["shared-only", "hybrid", "native"]},
        "writePolicy": {"enum": ["proposal-only"]}
      }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "profile", "settingsFile", "projectProfile"],
      "properties": {
        "enabled": {"type": "boolean"},
        "profile": {"const": "plugin:balanced-v1"},
        "settingsFile": {"const": "knowledge/policy.jsonc"},
        "projectProfile": {"const": "knowledge/retrieval-profile.json"}
      }
    }
  }
}
