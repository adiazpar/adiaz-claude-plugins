{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plugin://re-discipline/schemas/migration-gate-artifact.schema.json",
  "title": "Migration Gate Artifact",
  "type": "object",
  "required": [
    "schemaVersion", "transactionId", "planDigest", "gate", "passed",
    "checks", "fingerprints", "resultDigest"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "transactionId": {"type": "string", "pattern": "^M-[A-F0-9]{20}$"},
    "planDigest": {"$ref": "#/$defs/digest"},
    "gate": {"enum": ["structural", "semantic-traversal", "retrieval-context", "host-parity"]},
    "passed": {"type": "boolean"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "passed", "evidence"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "passed": {"type": "boolean"},
          "evidence": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "fingerprints": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {"$ref": "#/$defs/digest"}
    },
    "retrieval": {"$ref": "migration-retrieval-gate-evidence.schema.json"},
    "hostParity": {"$ref": "migration-host-conformance.schema.json"},
    "resultDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"gate": {"const": "retrieval-context"}}},
      "then": {"required": ["retrieval"], "not": {"required": ["hostParity"]}}
    },
    {
      "if": {"properties": {"gate": {"const": "host-parity"}}},
      "then": {"required": ["hostParity"], "not": {"required": ["retrieval"]}}
    }
  ],
  "additionalProperties": false
}
