{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plugin://re-discipline/schemas/closure-plan.schema.json",
  "title": "Frozen Closure Plan",
  "type": "object",
  "required": ["schemaVersion", "campaignId", "campaignRevision", "archiveDestination", "projectionFindingIds", "requiredRunIds", "requiredWorkItemIds", "requiredFindingIds", "requiredRetentionPaths", "digest"],
  "properties": {
    "schemaVersion": {"const": 2},
    "campaignId": {"type": "string", "pattern": "^C-[A-Z0-9][A-Z0-9-]{0,62}$"},
    "campaignRevision": {"type": "integer", "minimum": 1},
    "archiveDestination": {"type": "string", "pattern": "^docs/history/campaigns/[a-z0-9][a-z0-9-]{2,49}$"},
    "projectionFindingIds": {"$ref": "#/$defs/findingIds"},
    "requiredRunIds": {"type": "array", "items": {"type": "string", "pattern": "^R-[0-9]{8}-[0-9]{4,}$"}, "uniqueItems": true},
    "requiredWorkItemIds": {"type": "array", "items": {"type": "string", "pattern": "^W-[0-9]{4,}$"}, "uniqueItems": true},
    "requiredFindingIds": {"$ref": "#/$defs/findingIds"},
    "requiredRetentionPaths": {"type": "array", "items": {"type": "string", "pattern": "^R-[0-9]{8}-[0-9]{4,}:payload/.+$"}, "uniqueItems": true},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "findingIds": {"type": "array", "items": {"type": "string", "pattern": "^F-[0-9]{4,}$"}, "uniqueItems": true}
  },
  "additionalProperties": false
}
