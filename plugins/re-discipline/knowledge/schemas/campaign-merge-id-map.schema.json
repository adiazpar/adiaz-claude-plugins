{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plugin://re-discipline/schemas/campaign-merge-id-map.schema.json",
  "title": "Campaign Merge Identifier Map",
  "type": "object",
  "required": ["schemaVersion", "campaignId", "mappings", "digest"],
  "properties": {
    "schemaVersion": {"const": 1},
    "campaignId": {"$ref": "#/$defs/campaignId"},
    "mappings": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/mapping"}
    },
    "digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "campaignId": {
      "type": "string",
      "pattern": "^C-[A-Z0-9][A-Z0-9-]{0,62}$"
    },
    "campaignSlug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,49}$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$"
    },
    "mapping": {
      "type": "object",
      "required": ["kind", "sourceCampaignId", "sourceCampaignSlug", "sourceId", "sourcePath", "sourceDigest", "targetId", "targetPath", "historicalDate"],
      "properties": {
        "kind": {"enum": ["campaign", "work-item", "run", "finding", "evidence", "intake", "review", "review-load", "review-session", "event"]},
        "sourceCampaignId": {"$ref": "#/$defs/campaignId"},
        "sourceCampaignSlug": {"$ref": "#/$defs/campaignSlug"},
        "sourceId": {"type": "string", "minLength": 1},
        "sourcePath": {"type": "string", "minLength": 1},
        "sourceRevision": {"type": "integer", "minimum": 1},
        "sourceDigest": {"$ref": "#/$defs/digest"},
        "sourceCorrelationId": {"type": "string", "minLength": 1},
        "targetId": {"type": "string", "minLength": 1},
        "targetPath": {"type": "string", "minLength": 1},
        "historicalDate": {"$ref": "#/$defs/date"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
