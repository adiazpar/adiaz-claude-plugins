{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plugin://re-discipline/schemas/context-pack.schema.json",
  "title": "Re-Discipline immutable scoped context pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packId", "digest", "task", "scope", "generation", "role", "allowedTiers", "requestedProfile", "effectiveProfile", "activeLanes", "models", "fallbackReason", "tokenBudget", "estimatedTokens", "acceptedConstraints", "cards", "requiredHandles", "omitted"],
  "properties": {
    "schemaVersion": {"const": 2},
    "packId": {"type": "string", "pattern": "^context-[a-f0-9]{20}$"},
    "digest": {"$ref": "#/$defs/sha256"},
    "task": {"type": "string", "minLength": 1, "maxLength": 2000},
    "scope": {"$ref": "#/$defs/scope"},
    "generation": {"$ref": "#/$defs/generation"},
    "role": {"enum": ["manager", "drafter"]},
    "writeGrants": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "run.schema.json#/$defs/writeGrant"}
    },
    "allowedTiers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["profile", "navigation", "truth", "history", "backlog", "active", "campaign", "draft", "provisional", "archive", "intake", "memory", "playbook", "asset"]}
    },
    "requestedProfile": {"type": "string", "minLength": 1},
    "effectiveProfile": {"type": "string", "minLength": 1},
    "activeLanes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"enum": ["exact", "fts", "graph", "dense"]}
    },
    "models": {
      "type": "array",
      "maxItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?::[a-z0-9]+(?:-[a-z0-9]+)*)?@[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"}
    },
    "fallbackReason": {"type": ["string", "null"]},
    "tokenBudget": {"type": "integer", "minimum": 512, "maximum": 8192},
    "estimatedTokens": {"type": "integer", "minimum": 1, "maximum": 8192},
    "acceptedConstraints": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/constraint"}
    },
    "cards": {
      "type": "array",
      "maxItems": 50,
      "items": {"$ref": "context-card.schema.json"}
    },
    "requiredHandles": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 2000}
    },
    "omitted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateCards", "budget", "cardLimit", "staleSource"],
      "properties": {
        "candidateCards": {"type": "integer", "minimum": 0},
        "budget": {"type": "integer", "minimum": 0},
        "cardLimit": {"type": "integer", "minimum": 0},
        "staleSource": {"type": "integer", "minimum": 0}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "stateHeadRevision", "stateHeadDigest"],
      "properties": {
        "kind": {"enum": ["project", "active-run", "recruiting-run"]},
        "campaignId": {"type": "string", "pattern": "^C-[A-Z0-9][A-Z0-9-]{0,62}$"},
        "campaignSlug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "campaignRevision": {"type": "integer", "minimum": 1},
        "workItemId": {"type": "string", "pattern": "^W-[0-9]{4,}$"},
        "workItemRevision": {"type": "integer", "minimum": 1},
        "runId": {"type": "string", "pattern": "^R-[0-9]{8}-[0-9]{4,}$"},
        "runRevision": {"type": "integer", "minimum": 1},
        "candidateSlug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "recruitingRunId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "stateHeadRevision": {"type": "integer", "minimum": 0},
        "stateHeadDigest": {"$ref": "#/$defs/sha256"},
        "eventId": {"type": "string", "pattern": "^E-[0-9]{8}-[0-9]{6}-[A-Z0-9]{6,}$"}
      },
      "oneOf": [
        {
          "properties": {"kind": {"const": "project"}},
          "not": {"anyOf": [
            {"required": ["campaignId"]}, {"required": ["campaignSlug"]},
            {"required": ["workItemId"]}, {"required": ["runId"]},
            {"required": ["candidateSlug"]}, {"required": ["recruitingRunId"]}
          ]}
        },
        {
          "required": ["campaignId", "campaignSlug", "campaignRevision", "workItemId", "workItemRevision", "runId"],
          "properties": {"kind": {"const": "active-run"}},
          "not": {"anyOf": [{"required": ["candidateSlug"]}, {"required": ["recruitingRunId"]}]}
        },
        {
          "required": ["candidateSlug", "recruitingRunId"],
          "properties": {"kind": {"const": "recruiting-run"}},
          "not": {"anyOf": [
            {"required": ["campaignId"]}, {"required": ["campaignSlug"]},
            {"required": ["workItemId"]}, {"required": ["runId"]}
          ]}
        }
      ]
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "text", "sourceHandle"],
      "properties": {
        "id": {"type": "string", "pattern": "^constraint-[a-f0-9]{20}$"},
        "kind": {"enum": ["objective", "scope", "exclusion", "success", "closure", "problem", "acceptance", "finding"]},
        "text": {"type": "string", "minLength": 1, "maxLength": 4000},
        "sourceHandle": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "corpusFingerprint", "modelFingerprint", "runtimeFingerprint", "project", "worktree", "gitRevision", "dirtyFingerprint", "parserVersion", "chunkerVersion", "createdAt"],
      "properties": {
        "id": {"type": "string", "pattern": "^generation-[a-f0-9]{20}$"},
        "corpusFingerprint": {"$ref": "#/$defs/sha256"},
        "modelFingerprint": {"$ref": "#/$defs/sha256"},
        "runtimeFingerprint": {"$ref": "#/$defs/sha256"},
        "project": {"type": "string", "minLength": 1},
        "worktree": {"type": "string", "minLength": 1},
        "gitRevision": {"type": "string", "minLength": 1},
        "dirtyFingerprint": {"type": "string", "minLength": 1},
        "parserVersion": {"type": "string", "minLength": 1},
        "chunkerVersion": {"type": "string", "minLength": 1},
        "createdAt": {"type": "string", "format": "date-time"}
      }
    }
  }
}
