{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plugin://re-discipline/schemas/normalization-queue.schema.json",
  "title": "Archive fallback normalization queue",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "threshold", "counts", "requestKeys", "suggestions", "digest"],
  "properties": {
    "schemaVersion": {"const": 3},
    "threshold": {"type": "integer", "minimum": 1},
    "counts": {
      "type": "object",
      "propertyNames": {"pattern": "^sha256:[a-f0-9]{64}$"},
      "additionalProperties": {"type": "integer", "minimum": 1}
    },
    "requestKeys": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}},
    "suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "revision", "sourceKey", "reportDigest", "campaignId", "campaignSlug", "runId", "reportPath", "reportHandle", "sourceHandle", "serveCount", "triggers", "status", "firstSuggestedAt", "lastObservedAt", "digest"],
        "properties": {
          "id": {"type": "string", "pattern": "^normalization-[a-f0-9]{20}$"},
          "revision": {"type": "integer", "minimum": 1},
          "sourceKey": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
          "reportDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
          "campaignId": {"type": "string", "pattern": "^C-[A-Z0-9][A-Z0-9-]{0,62}$"},
          "campaignSlug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "runId": {"type": "string", "pattern": "^R-[0-9]{8}-[0-9]{4,}$"},
          "reportPath": {"type": "string", "minLength": 1},
          "reportHandle": {"type": "string", "pattern": "^run:R-[0-9]{8}-[0-9]{4,}$"},
          "sourceHandle": {"type": "string", "pattern": "^path:.+$"},
          "serveCount": {"type": "integer", "minimum": 0},
          "triggers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["retrieval-threshold", "manager-request", "closure"]}
          },
          "status": {"enum": ["queued", "claimed", "acknowledged", "resolved"]},
          "firstSuggestedAt": {"type": "string", "format": "date-time"},
          "lastObservedAt": {"type": "string", "format": "date-time"},
          "claimedBy": {"type": "string", "minLength": 1},
          "claimedAt": {"type": "string", "format": "date-time"},
          "acknowledgedBy": {"type": "string", "minLength": 1},
          "acknowledgedAt": {"type": "string", "format": "date-time"},
          "resolvedBy": {"type": "string", "minLength": 1},
          "resolvedAt": {"type": "string", "format": "date-time"},
          "resolution": {
            "type": "object",
            "additionalProperties": false,
            "required": ["schemaVersion", "disposition", "sourceReport", "curatorRunId", "curatorRunDigest", "curatorReport", "intakeId", "intakeRevision", "intakeDigest", "coverageDigest", "reviewId", "reviewRevision", "reviewDigest", "resolvedFindingIds", "digest"],
            "properties": {
              "schemaVersion": {"const": 2},
              "disposition": {"enum": ["normalized", "reviewed-non-claim"]},
              "sourceReport": {"$ref": "#/$defs/fileHandle"},
              "curatorRunId": {"type": "string", "pattern": "^R-[0-9]{8}-[0-9]{4,}$"},
              "curatorRunDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
              "curatorReport": {"$ref": "#/$defs/fileHandle"},
              "intakeId": {"type": "string", "pattern": "^I-[A-Z0-9][A-Z0-9-]{0,62}$"},
              "intakeRevision": {"type": "integer", "minimum": 2},
              "intakeDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
              "coverageDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
              "reviewId": {"type": "string", "pattern": "^V-[A-Z0-9][A-Z0-9-]{0,62}$"},
              "reviewRevision": {"type": "integer", "minimum": 1},
              "reviewDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
              "resolvedFindingIds": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string", "pattern": "^F-[A-Z0-9][A-Z0-9-]{0,62}$"}
              },
              "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
            }
          },
          "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
        }
      }
    },
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  },
  "$defs": {
    "fileHandle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    }
  }
}
