{
  "$schema": "plugin://re-discipline/schemas/knowledge-settings.schema.json",
  "schemaVersion": 2,

  // Canonical records and maintained project sources are indexed. Derived
  // caches can always be rebuilt from these files.
  "sources": {
    "truth": true,
    "historyFindings": true,
    "backlog": true,
    "activeFindings": true,
    "sharedMemory": true,

    // Until the ratified normalized-beats-raw release gate passes, returned
    // report chunks remain a lower-ranked fallback with provenance labels.
    "reportFallback": true,
    "additional": []
  },

  "models": {
    "execution": "local"
  },

  "telemetry": {
    "mode": "metrics-only"
  },

  "budgets": {
    "searchTokens": 3072,
    "managerContextTokens": 6144,
    "drafterContextTokens": 3072,
    "maxCards": 16,
    "maxBytes": 32768
  },

  "archive": {
    "reportFallbackUntilMeasured": true,
    "normalizationTriggerHits": 3,
    "fallbackMode": "default-fallback"
  }
}
