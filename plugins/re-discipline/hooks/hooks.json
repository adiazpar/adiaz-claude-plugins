{
  "description": "Conditional lifecycle reminders for projects initialized with re-discipline. The helpers support the neutral 0.2 profile and legacy Claude-profile projects.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PLUGIN_ROOT/hooks/re-discipline-hook.sh\" session-start",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"& (Join-Path ([Environment]::GetEnvironmentVariable('CLAUDE_PLUGIN_ROOT')) 'hooks/re-discipline-hook.ps1') 'session-start'\"",
            "timeout": 10,
            "statusMessage": "Checking re-discipline project state"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PLUGIN_ROOT/hooks/re-discipline-hook.sh\" pre-compact",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"& (Join-Path ([Environment]::GetEnvironmentVariable('CLAUDE_PLUGIN_ROOT')) 'hooks/re-discipline-hook.ps1') 'pre-compact'\"",
            "timeout": 10,
            "statusMessage": "Preserving re-discipline campaign state"
          }
        ]
      }
    ]
  }
}
